# =====================================================================
# Automate Panu AI — environment variables (every one the app uses).
#
#   Dokploy:  Compose app → Environment → paste your filled-in copy.
#   Locally:  cp .env.example .env   (then fill in), docker compose up -d
#
# Generate every secret at once:   node scripts/generate-secrets.mjs
# Use URL-safe values (hex): several are embedded in connection URLs.
# REQUIRED = the stack refuses to start without it.
# =====================================================================

# ---------------------------------------------------------------------
# Domains (REQUIRED for production). NEXT_PUBLIC_* are inlined at BUILD
# time: redeploy (rebuild) after changing them.
# ---------------------------------------------------------------------
# The CRM.
NEXT_PUBLIC_APP_URL=https://chat.axxeler.in
# The public website (same app; routed by Host).
NEXT_PUBLIC_MARKETING_URL=https://automatepanuai.axxeler.in
# Base for invite links. Same as the app URL.
NEXT_PUBLIC_SITE_URL=https://chat.axxeler.in
# UI language: en | es | pt | ko
NEXT_PUBLIC_APP_LOCALE=en
# Invite links may only point at these hosts (anti Host-header spoofing).
ALLOWED_INVITE_HOSTS=chat.axxeler.in

# ---------------------------------------------------------------------
# Database (REQUIRED). Three roles, three passwords:
#   postgres             superuser: only `migrate` (setup) and `backup`
#   wacrm_owner          owns the schema, runs migrations
#   wacrm_authenticator  what the app and PostgREST log in as; no
#                        privileges of its own (switches role per request)
# ---------------------------------------------------------------------
POSTGRES_DB=wacrm
POSTGRES_PASSWORD=change-me-hex
WACRM_OWNER_PASSWORD=change-me-hex
WACRM_AUTHENTICATOR_PASSWORD=change-me-hex
# Signs the short-lived tokens the app sends to the private PostgREST.
POSTGREST_JWT_SECRET=change-me-at-least-32-chars-hex

# Postgres tuning (optional; defaults fit a 4 GB VPS, see the deploy doc).
# PG_SHARED_BUFFERS=512MB
# PG_EFFECTIVE_CACHE_SIZE=1536MB
# PG_WORK_MEM=8MB
# PG_MAINTENANCE_WORK_MEM=128MB
# PG_MAX_CONNECTIONS=100
# DB_MEMORY_LIMIT=1536m
# APP_MEMORY_LIMIT=1024m
# App-side connection pools (optional).
# DB_POOL_MAX=10
# AUTH_DB_POOL_MAX=5

# ---------------------------------------------------------------------
# Redis (REQUIRED): rate limits shared across app instances.
# ---------------------------------------------------------------------
REDIS_PASSWORD=change-me-hex

# ---------------------------------------------------------------------
# Object storage, MinIO (REQUIRED). Buckets avatars / chat-media /
# flow-media are created automatically on first start.
# ---------------------------------------------------------------------
MINIO_ROOT_USER=automatepanu
MINIO_ROOT_PASSWORD=change-me-hex
# Public base URL for media links (Dokploy domain → minio, port 9000).
# S3_PUBLIC_URL=https://files.axxeler.in

# ---------------------------------------------------------------------
# Sign-in (REQUIRED). Signs session cookies and emailed links. Rotating it
# signs everyone out and invalidates links already sent.
# ---------------------------------------------------------------------
AUTH_SECRET=change-me-at-least-32-chars-hex

# ---------------------------------------------------------------------
# Email over SMTP (REQUIRED): sign-up verification, password reset,
# email change, team invites. Any provider (Brevo, Postmark, SES,
# Mailgun, Zoho, Gmail Workspace relay…). The From domain needs the
# provider's SPF/DKIM DNS records or mail lands in spam.
# ---------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true only for implicit TLS on port 465 (587 upgrades via STARTTLS).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Automate Panu AI <no-reply@chat.axxeler.in>"

# ---------------------------------------------------------------------
# WhatsApp / Meta (REQUIRED)
# ---------------------------------------------------------------------
# AES-256-GCM key for stored WhatsApp/AI tokens: 64 hex chars.
# NEVER change it after go-live: stored tokens become unreadable.
ENCRYPTION_KEY=change-me-64-hex-chars
# Meta for Developers → your app → App settings → Basic → App secret.
# Verifies every webhook. Several apps: comma-separate their secrets.
META_APP_SECRET=your-meta-app-secret
# Only for message templates with an IMAGE/VIDEO/DOCUMENT header.
# META_APP_ID=
# Webhook URL to enter in Meta → WhatsApp → Configuration:
#   https://chat.axxeler.in/api/whatsapp/webhook
# Testing only: don't submit templates to Meta, just log them.
# WHATSAPP_TEMPLATES_DRY_RUN=1

# ---------------------------------------------------------------------
# Scheduler (REQUIRED): the `cron` service sends this to
# /api/automations/cron and /api/flows/cron every minute.
# ---------------------------------------------------------------------
AUTOMATION_CRON_SECRET=change-me-hex

# ---------------------------------------------------------------------
# Backups (optional): pg_dump into the `backups` volume.
# ---------------------------------------------------------------------
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14

# ---------------------------------------------------------------------
# AI assistant (optional tuning; provider keys are set per account in
# the app and stored encrypted).
# ---------------------------------------------------------------------
# AI_REQUEST_TIMEOUT_MS=30000
# AI_CONTEXT_MESSAGE_LIMIT=20
# Allow AI base URLs on private hosts (e.g. a local Ollama).
# AI_PROVIDER_ALLOWED_PRIVATE_HOSTS=ollama.internal

# Verbose migration logs (echo every SQL statement).
# MIGRATE_VERBOSE=1
